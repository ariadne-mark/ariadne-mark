include Dockerfile compose.yaml .dockerignore THIRD_PARTY.md CHANGELOG.md CONTRIBUTING.md SECURITY.md CODE_OF_CONDUCT.md
recursive-include docs *.md *.txt *.json
recursive-include compliance *.md *.json
recursive-include scripts *.py *.sh
recursive-include benchmarks *.md *.txt *.py *.json *.jsonl
recursive-include examples *.py *.md *.txt *.json *.html *.yaml *.yml
include examples/stock_product/Dockerfile examples/stock_product/.dockerignore
recursive-include tests *.py *.md
prune examples/stateless_product
prune dist
prune build
global-exclude *.pyc
global-exclude ._* .DS_Store
recursive-include apps *.md *.conf *.yaml *.yml
recursive-include src *.md
recursive-include .github *.md *.yml *.yaml
include .gitignore

recursive-include requirements *.lock

prune release-dist
prune .ci-work
